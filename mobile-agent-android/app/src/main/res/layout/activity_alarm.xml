<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101217"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/alarmTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/alarm_ringing"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmMissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/location_mission_title"
        android:textColor="#E5E7EB"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/targetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#FBBF24"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/confirmArrivalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/confirm_arrival" />

    <Button
        android:id="@+id/manualDismissButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/manual_dismiss" />

    <Button
        android:id="@+id/snoozeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/snooze_alarm" />

    <TextView
        android:id="@+id/alarmNoDismissNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/alarm_no_dismiss_note"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <!-- Procrastination card (shown after timeout if mission not completed) -->
    <LinearLayout
        android:id="@+id/procrastinationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#1F2937"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/procrastinationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/procrastination_detected_title"
            android:textColor="#FBBF24"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/procrastinationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/procrastination_detected_body"
            android:textColor="#E5E7EB"
            android:textSize="13sp" />

        <Button
            android:id="@+id/handleResistanceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/handle_resistance_now" />

        <Button
            android:id="@+id/skipResistanceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/skip_for_now" />
    </LinearLayout>

</LinearLayout>
