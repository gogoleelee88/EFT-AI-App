<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/behaviorSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잠깐, 마음이 멈췄다면 같이 조절해요"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/behaviorSheetQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#111827"
        android:textSize="18sp"
        android:text="질문이 여기에 표시됩니다." />

    <TextView
        android:id="@+id/behaviorSheetReasonText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#6b7280"
        android:textSize="12sp"
        android:text="근거 신호: -"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/behaviorSheetWorkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="괜찮아요, 계속해요" />

        <Button
            android:id="@+id/behaviorSheetRestButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="잠깐 멈춰볼게요" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/behaviorSheetMoveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="잠깐 이동" />

        <Button
            android:id="@+id/behaviorSheetExerciseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="가볍게 스트레칭" />

        <Button
            android:id="@+id/behaviorSheetOtherButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="기타" />
    </LinearLayout>

    <Button
        android:id="@+id/behaviorSheetDismissButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="아직 판단이 어렵네요" />
</LinearLayout>
