<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.eft.mobileagent.FocusFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home_tab">
        <argument
            android:name="tabMode"
            app:argType="string"
            android:defaultValue="HOME" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_alarm"
        android:name="com.eft.mobileagent.AlarmFragment"
        android:label="Add Alarm"
        tools:layout="@layout/fragment_add_alarm_tab">
        <argument
            android:name="tabMode"
            app:argType="string"
            android:defaultValue="ADD_ALARM" />
    </fragment>

    <fragment
        android:id="@+id/nav_my_page"
        android:name="com.eft.mobileagent.MyFragment"
        android:label="My Page"
        tools:layout="@layout/fragment_my_page_tab">
        <argument
            android:name="tabMode"
            app:argType="string"
            android:defaultValue="MY_PAGE" />
    </fragment>
</navigation>
