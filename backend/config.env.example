HUGGINGFACE_TOKEN=<SET_ME>
MODEL_NAME=<SET_ME>
DEBUG=true
HOST=0.0.0.0
PORT=8000

# n8n 웹훅 URL (노션 연동용)
# 예시: https://your-n8n-instance.com/webhook/intake-data
N8N_WEBHOOK_URL=

# Firebase Admin (required for /api/auth/login ID token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Reminder worker / push
REMINDER_DEFAULT_TZ=Asia/Seoul
REMINDER_IN_PROCESS_ENABLED=true
REMINDER_TICK_SECONDS=60
REMINDER_CLAIM_LIMIT=100
REMINDER_LOCK_SECONDS=55
REMINDER_MAX_ATTEMPTS=3
REMINDER_BACKOFF_BASE_SECONDS=60

WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_SUB=mailto:admin@example.com
ENABLE_FCM_PUSH=true

# Notion OAuth (required for user-level Notion integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/notion/oauth/callback
NOTION_USER_DB_NAME=MoodTalk 감정 기록
FRONTEND_DASHBOARD_URL=http://localhost:5173/dashboard
ENCRYPTION_KEY=
SECURITY_STRICT_MISSION_RUN=false

# Legacy shared Notion integration (optional)
NOTION_API_KEY=
NOTION_DATABASE_ID=

DATABASE_URL=<SET_ME>

# PR1-P0(Security/Policy): no hardcoded defaults in code, must be set via env.
SECRET_KEY=<SET_ME>
API_KEY=<SET_ME>
PREMIUM_API_KEY=<SET_ME>

# Structured LLM provider for compare/intake paths
# Options: vllm | openai (default: openai)
STRUCTURED_LLM_PROVIDER=openai

# OpenAI (structured only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2pro
OPENAI_EMBED_MODEL=text-embedding-3-small
GOOGLE_MAPS_API_KEY=
KAKAO_REST_API_KEY=

# Proposal OS draft provider
# auto -> openai(if key) -> vllm -> mock
PROPOSAL_LLM_PROVIDER=auto
PROPOSAL_OPENAI_MODEL=gpt-5.2pro
PROPOSAL_VLLM_BASE_URL=http://127.0.0.1:8001
PROPOSAL_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
PROPOSAL_LLM_TIMEOUT_SEC=20

# Chat Hub provider selection (new /api/chat orchestrator)
# Options: azure | openai (default: openai)
LLM_PROVIDER=openai

# OpenChat provider selection (new /api/openchat)
# Options: openai | azure (default: openai)
OPENCHAT_PROVIDER=openai

# Azure OpenAI (chat hub)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Azure AI Search (doc RAG retrieve)
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=
AZURE_AI_SEARCH_API_VERSION=2023-11-01

# Dataset priors (runtime, no training)
DATASET_PRIORS_PATH=backend/datasets/dataset_priors.json

# Cycle estimation policy (optional overrides)
CYCLE_DEFAULT_LEN_DAYS=28
CYCLE_MIN_LEN_DAYS=18
CYCLE_MAX_LEN_DAYS=45
CYCLE_LUTEAL_LEN_DAYS=14
CYCLE_LOW_STD_THRESHOLD_DAYS=2.0
CYCLE_HIGH_STD_THRESHOLD_DAYS=5.0
CYCLE_LOW_CV_THRESHOLD=0.08
CYCLE_HIGH_CV_THRESHOLD=0.18
CYCLE_HIGH_CONF_MIN_CYCLES=4
CYCLE_MED_CONF_MIN_CYCLES=2
CYCLE_WINDOW_MARGIN_LOW_DAYS=1
CYCLE_WINDOW_MARGIN_MED_DAYS=2
CYCLE_WINDOW_MARGIN_HIGH_DAYS=4
CYCLE_SIGMA_MENSTRUATION_DAYS=1.8
CYCLE_SIGMA_FOLLICULAR_DAYS=3.2
CYCLE_SIGMA_OVULATION_DAYS=1.1
CYCLE_SIGMA_LUTEAL_DAYS=3.8
