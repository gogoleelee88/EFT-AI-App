# 운영 환경 설정 (.env.production으로 복사 후 실제 값 입력)

# API Base URL (운영 백엔드 서버)
# Recommended for production:
# Keep API calls first-party (same-origin) and rely on Vercel rewrites for /api -> backend.
# Leave these unset unless you intentionally want cross-site calls.
# VITE_API_BASE_URL=
# VITE_PRODUCTION_ORIGIN=
VITE_PROVIDER=openai

# vLLM 엔진 URLs (운영 서버)
VITE_VLLM_ENGINE_A_URL=https://eft-ai-app.onrender.com/vllm/engine-a
VITE_VLLM_ENGINE_B_URL=https://eft-ai-app.onrender.com/vllm/engine-b

# 운영 모드 플래그
VITE_DEBUG_MODE=false

# Firebase 설정 (운영용 - 실제 값으로 교체 필요)
VITE_FIREBASE_API_KEY=your-prod-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=eft-ai-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eft-ai-app
VITE_FIREBASE_STORAGE_BUCKET=eft-ai-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=987654321
VITE_FIREBASE_APP_ID=1:987654321:web:production

# 로깅 레벨 (운영 시 에러만)
VITE_LOG_LEVEL=error

# Analytics 및 모니터링 (운영 환경에서만 활성화)
VITE_ENABLE_ANALYTICS=true
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
