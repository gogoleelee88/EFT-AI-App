{
  "name": "eft-ai-app",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "EFT 기반 AI 심리관리 앱 - AI와 함께하는 마음 여행",
  "keywords": [
    "EFT",
    "AI",
    "심리관리",
    "마음챙김",
    "감정관리",
    "PWA",
    "React",
    "Transformers.js"
  ],
  "author": "EFT AI Team",
  "license": "MIT",
  "homepage": "https://eft-ai-app.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/eft-ai-team/eft-ai-app.git"
  },
  "bugs": {
    "url": "https://github.com/eft-ai-team/eft-ai-app/issues"
  },
  "scripts": {
    "preinstall": "node ./scripts/preinstall.cjs",
    "postinstall": "node ./scripts/postinstall.cjs",
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "vite build",
    "typecheck": "tsc -b",
    "build:ci": "vite build --mode production --logLevel warn",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node ./scripts/run-vitest.cjs",
    "test:ui": "node ./scripts/run-vitest.cjs --ui",
    "test:watch": "node ./scripts/run-vitest.cjs --watch"
  },
