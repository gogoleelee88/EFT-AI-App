# Copy to frontend/.env.development or frontend/.env.production locally.
# PR1-P0(Env/Secrets): keep runtime env files out of git.

# Backend API
VITE_API_BASE_URL=http://localhost:8000

# Auth/API keys
VITE_PROVIDER=openai
VITE_PREMIUM_VIA_BACKEND=true
VITE_PREMIUM_API_KEY=<SET_ME>
VITE_API_KEY=<SET_ME>

# Firebase
VITE_FIREBASE_API_KEY=<SET_ME>
VITE_FIREBASE_AUTH_DOMAIN=<SET_ME>
VITE_FIREBASE_PROJECT_ID=<SET_ME>
VITE_FIREBASE_STORAGE_BUCKET=<SET_ME>
VITE_FIREBASE_MESSAGING_SENDER_ID=<SET_ME>
VITE_FIREBASE_APP_ID=<SET_ME>

# Runtime flags
VITE_ENABLE_SUDS_FALLBACK=true
VITE_DEBUG=false
VITE_ENABLE_SW_IN_DEV=false
VITE_WEBPUSH_VAPID_PUBLIC_KEY=
