# Copy to frontend/.env.development or frontend/.env.production locally.
# PR1-P0(Env/Secrets): keep runtime env files out of git.

# Backend API
VITE_API_BASE_URL=http://localhost:8000
# Optional: set when VITE_API_BASE_URL is not provided explicitly
# VITE_PRODUCTION_ORIGIN=

# App install / QR links
# Example APK: https://eft-ai-app-frontend-4ia5.vercel.app/latest.apk
# Example Play Store: https://play.google.com/store/apps/details?id=com.eft.mobileagent
VITE_APP_INSTALL_URL=
VITE_DIRECT_APK_URL=
# Optional: direct APK URL for QR guide.
# If omitted, app install URL is used.
VITE_INTERNAL_TEST_QR_URL=
VITE_PLAY_STORE_URL=

# Auth/API keys
VITE_PROVIDER=openai
VITE_PREMIUM_VIA_BACKEND=true
VITE_PREMIUM_API_KEY=<SET_ME>
VITE_API_KEY=<SET_ME>

# Firebase
VITE_FIREBASE_API_KEY=<SET_ME>
VITE_FIREBASE_AUTH_DOMAIN=<SET_ME>
VITE_FIREBASE_PROJECT_ID=<SET_ME>
VITE_FIREBASE_STORAGE_BUCKET=<SET_ME>
VITE_FIREBASE_MESSAGING_SENDER_ID=<SET_ME>
VITE_FIREBASE_APP_ID=<SET_ME>

# Runtime flags
VITE_ENABLE_SUDS_FALLBACK=true
VITE_DEBUG=false
VITE_ENABLE_SW_IN_DEV=false
VITE_WEBPUSH_VAPID_PUBLIC_KEY=

# Optional local/vllm override
VITE_VLLM_ENGINE_A_URL=/v1
VITE_VLLM_ENGINE_B_URL=/v1
