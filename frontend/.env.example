VITE_API_BASE_URL=<SET_ME>
VITE_PREMIUM_VIA_BACKEND=true
VITE_PREMIUM_API_KEY=<SET_ME>

# P11 SUDS 휴리스틱 설정
# A-option 폴백 활성화 (백엔드 actions 없을 시 클라이언트 휴리스틱 사용)
# Production: true (권장), Development: true (테스트용)
VITE_ENABLE_SUDS_FALLBACK=true

# 디버그 로깅 활성화 (개발/디버깅용)
# Production: false (권장), Development: true
VITE_DEBUG=false
