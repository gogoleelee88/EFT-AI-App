{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/last.ask", "destination": "/latest.apk", "permanent": false }
  ],
  "headers": [
    {
      "source": "/latest.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"latest.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://eft-ai-app.onrender.com/api/:path*" },
    { "source": "/v1/:path*", "destination": "https://eft-ai-app.onrender.com/v1/:path*" },
    { "source": "/suds", "destination": "https://eft-ai-app.onrender.com/suds" },
    { "source": "/ws/:path*", "destination": "https://eft-ai-app.onrender.com/ws/:path*" },
    { "source": "/health", "destination": "https://eft-ai-app.onrender.com/health" },
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
