{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/last.ask", "destination": "/latest.apk", "permanent": false }
  ],
  "headers": [
    {
      "source": "/latest.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"latest.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
