{
  "name": "eft-ai-app",
  "version": "1.0.0",
  "description": "EFT AI Application with AR/VR support",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "fix:registry": "node ./scripts/ensure-registry.js --apply",
    "test:npm-registry": "node ./scripts/check-npm-registry.js",
    "dev": "npm run frontend",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:vercel": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "test": "npm run --workspace frontend test --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.54.0"
  }
}
